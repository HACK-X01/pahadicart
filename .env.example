# ==============================================================================
# PAHADICART - HIMACHAL HYPERLOCAL OPERATIONS & 2-HOUR LOGISTICS PLATFORM
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3333
APP_URL=https://pahadicart.vercel.app

# Database: PostgreSQL 16 + PostGIS (Spatial SRID 4326)
DATABASE_URL=postgresql://pahadi_admin:SECURE_PASSWORD@localhost:5432/pahadicart_db?sslmode=prefer
DB_POOL_MIN=5
DB_POOL_MAX=50

# Caching & Real-time Geospatial Store: Redis 7
REDIS_URL=redis://:REDIS_PASSWORD@localhost:6379/0
REDIS_GEO_KEY=riders:telemetry:geo

# Authentication & RBAC (JWT & Refresh Token)
JWT_SECRET=YOUR_RANDOM_SUPER_SECRET_JWT_KEY_32_CHARS_MIN
JWT_REFRESH_SECRET=YOUR_RANDOM_REFRESH_TOKEN_SECRET_KEY
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Maps & Mountain Routing Infrastructure (Leaflet / Mapbox Abstraction)
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91ci1tYXBib3gtdXNlciIsImEiOiJ5b3VyLXRva2VuIn0
OSRM_HILL_ROUTING_ENDPOINT=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=AIzaSy...

# Cloud Storage (S3 / Cloudflare R2 for Merchant KYC & Proof-Of-Delivery)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1
AWS_S3_BUCKET=pahadicart-mountain-assets

# Push Notifications (Firebase Cloud Messaging - FCM HTTP v1)
FCM_PROJECT_ID=pahadicart-himachal
FCM_CLIENT_EMAIL=firebase-adminsdk@pahadicart.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# WhatsApp Business Cloud API & SMS Gateways (Meta Cloud / Gupshup / Twilio)
WHATSAPP_PHONE_NUMBER_ID=10928374659281
WHATSAPP_BUSINESS_ACCOUNT_ID=98273645129
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_VERIFY_TOKEN=pahadi_meta_verify_token_2026
SMS_PROVIDER=TWILIO # or GUPSHUP / FAST2SMS
SMS_ACCOUNT_SID=AC...
SMS_AUTH_TOKEN=...

# Payment Gateway Infrastructure (RazorpayX / Cashfree Payouts)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAYX_ACCOUNT_NUMBER=23232300...
CASHFREE_APP_ID=...
CASHFREE_SECRET_KEY=...

# Meteorological Live Sync (Open-Meteo & IMD Hill Corridors)
WEATHER_PROVIDER=OPEN_METEO # 100% Free & Open
IMD_API_KEY=YOUR_IMD_KEY_IF_APPLICABLE

# ==============================================================================
# CONFIGURABLE PRD OPERATIONAL DECISIONS (Defaults pending Product Owner confirmation)
# ==============================================================================
# Decision 1: Merchant Acceptance Timeout (PRD Sec 4.2: 60s vs Sec 7.1: 90s)
MERCHANT_ACCEPTANCE_TIMEOUT_SECONDS=75

# Decision 2 & 3: Mountain Transit Parameters
ETA_ALPHA_GRADIENT_FACTOR=1.45
V_BASE_HILL_KMH=24
HAIRPIN_TURN_PENALTY_RATE=0.035
STAIRCASE_PENALTY_MINS_PER_STEP=0.25

# Weather SLA Buffers (Minutes)
WEATHER_RAIN_BUFFER_MINS=15
WEATHER_FOG_BUFFER_MINS=25
WEATHER_SNOW_BUFFER_MINS=35

# Platform Surcharges & Financial Cadence
PLATFORM_FEE_INR=5.00
PACKAGING_FEE_DEFAULT_INR=10.00
SETTLEMENT_CYCLE=T+1 # T+1 or T+2
